# Normalize text files for consistent Windows/macOS/Linux collaboration.
* text=auto eol=lf

# Unity serialized YAML files stay text-mergeable and use the local Smart Merge driver.
*.unity text eol=lf merge=unityyamlmerge
*.prefab text eol=lf merge=unityyamlmerge
*.asset text eol=lf merge=unityyamlmerge
*.mat text eol=lf merge=unityyamlmerge
*.anim text eol=lf merge=unityyamlmerge
*.controller text eol=lf merge=unityyamlmerge
*.overrideController text eol=lf merge=unityyamlmerge
*.playable text eol=lf merge=unityyamlmerge
*.mask text eol=lf merge=unityyamlmerge
*.renderTexture text eol=lf merge=unityyamlmerge
*.terrainlayer text eol=lf merge=unityyamlmerge
*.shadervariants text eol=lf merge=unityyamlmerge
*.meta text eol=lf

# Common Unity/C# text formats.
*.cs text eol=lf diff=csharp
*.asmdef text eol=lf
*.asmref text eol=lf
*.shader text eol=lf
*.compute text eol=lf
*.cginc text eol=lf
*.hlsl text eol=lf
*.glsl text eol=lf
*.inputactions text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.uxml text eol=lf
*.uss text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Conservative LFS policy for binary source assets that are usually large and not useful in text diffs.
*.psd filter=lfs diff=lfs merge=lfs -text
*.psb filter=lfs diff=lfs merge=lfs -text
*.kra filter=lfs diff=lfs merge=lfs -text
*.clip filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
*.obj filter=lfs diff=lfs merge=lfs -text
*.abc filter=lfs diff=lfs merge=lfs -text
*.mb filter=lfs diff=lfs merge=lfs -text
*.ma filter=lfs diff=lfs merge=lfs -text
*.max filter=lfs diff=lfs merge=lfs -text
*.c4d filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.aif filter=lfs diff=lfs merge=lfs -text
*.aiff filter=lfs diff=lfs merge=lfs -text
*.flac filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.ogg filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.mov filter=lfs diff=lfs merge=lfs -text
*.webm filter=lfs diff=lfs merge=lfs -text
*.avi filter=lfs diff=lfs merge=lfs -text
*.mkv filter=lfs diff=lfs merge=lfs -text
*.exr filter=lfs diff=lfs merge=lfs -text
*.hdr filter=lfs diff=lfs merge=lfs -text
*.tga filter=lfs diff=lfs merge=lfs -text
*.tif filter=lfs diff=lfs merge=lfs -text
*.tiff filter=lfs diff=lfs merge=lfs -text
*.unitypackage filter=lfs diff=lfs merge=lfs -text

# Small raster/audio/font assets are binary but not automatically forced into LFS.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.ttf binary
*.otf binary

# MVC (BxB Studio) large binaries -> LFS. Path-scoped so the repo-wide png/jpg
# "binary but not LFS" policy stays unchanged for existing assets. '?' matches the
# space in "BxB Studio".
Assets/BxB?Studio/**/*.png filter=lfs diff=lfs merge=lfs -text
Assets/BxB?Studio/**/*.jpg filter=lfs diff=lfs merge=lfs -text
Assets/BxB?Studio/**/*.jpeg filter=lfs diff=lfs merge=lfs -text
Assets/BxB?Studio/**/*.skp filter=lfs diff=lfs merge=lfs -text
Packages/dev.bxbstudio.*/**/*.png filter=lfs diff=lfs merge=lfs -text
Packages/dev.bxbstudio.*/**/*.jpg filter=lfs diff=lfs merge=lfs -text
Packages/dev.bxbstudio.*/**/*.jpeg filter=lfs diff=lfs merge=lfs -text
Packages/dev.bxbstudio.*/**/*.skp filter=lfs diff=lfs merge=lfs -text
